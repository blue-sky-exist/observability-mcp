# MCP
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Elasticsearch
ES_URLS=http://elasticsearch:9200
ES_AUTH_TYPE=none
ES_USERNAME=
ES_PASSWORD=
ES_BEARER_TOKEN=
ES_API_KEY=
ES_TIMEOUT_SECONDS=30
ES_VERIFY_TLS=true
ES_CA_FILE=
ES_PIT_KEEP_ALIVE=2m
ES_DEFAULT_INDEX=*
ES_ALLOWED_INDEX_PATTERNS=*
ES_MAX_LIMIT=200
LOG_MAX_STACK_TRACE_LENGTH=12000
CURSOR_TTL_SECONDS=120
LOG_PROFILES_FILE=config/log-profiles.yaml

# Prometheus-compatible API. Examples:
# Prometheus:              http://prometheus:9090/api/v1
# VictoriaMetrics single: http://victoriametrics:8428/api/v1
# VictoriaMetrics cluster:http://vmselect:8481/select/0/prometheus/api/v1
METRICS_API_BASE_URL=http://prometheus:9090/api/v1
METRICS_AUTH_TYPE=none
METRICS_USERNAME=
METRICS_PASSWORD=
METRICS_BEARER_TOKEN=
METRICS_API_KEY=
METRICS_TIMEOUT_SECONDS=30
METRICS_VERIFY_TLS=true
METRICS_CA_FILE=
METRICS_MAX_SERIES=1000
METRICS_MAX_POINTS=10000
METRICS_MAX_RANGE_SECONDS=604800

# SkyWalking GraphQL
SKYWALKING_GRAPHQL_URL=http://skywalking-oap:12800/graphql
SKYWALKING_AUTH_TYPE=none
SKYWALKING_USERNAME=
SKYWALKING_PASSWORD=
SKYWALKING_BEARER_TOKEN=
SKYWALKING_API_KEY=
SKYWALKING_TIMEOUT_SECONDS=30
SKYWALKING_VERIFY_TLS=true
SKYWALKING_CA_FILE=
SKYWALKING_TIMEZONE=Asia/Shanghai
SKYWALKING_MAX_RANGE_SECONDS=86400
SKYWALKING_MAX_PAGE_SIZE=100
SKYWALKING_SERVICE_CACHE_TTL_SECONDS=600
SKYWALKING_SERVICE_CACHE_MAX_SIZE=500
